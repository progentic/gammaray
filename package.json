{
  "name": "gammaray",
  "description": "SOC Dashboard: SIEM and CSV log analytics, custom metric visualizations, PDF reports and leadership EXSUMs, and CTI/CVE analysis.",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node scripts/run-tests.mjs src",
    "test:e2e": "node scripts/run-tests.mjs tests/e2e",
    "check:router": "node scripts/check-router.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.0.0",
    "globals": "^15.15.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
