{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gammaray:phase0:normalized-event:draft-2",
  "title": "GammaRay normalized event - D03 review proposal only",
  "description": "DRAFT ONLY, owner acceptance of approach but not field model. GammaRay v0.0.2 Phase 0. Requires local registration of two family schemas.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "parser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "connector_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "connector_kind": {
          "enum": [
            "splunk",
            "cisco_syslog",
            "windows_event",
            "macos_log",
            "csv"
          ]
        },
        "producer_vendor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer_product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "producer_event_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "connector_id",
        "connector_kind"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "ingest_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "event_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "zone_status": {
          "enum": [
            "source_provided",
            "assumed",
            "missing"
          ]
        },
        "offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "assumption_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      },
      "required": [
        "ingest_utc",
        "event_utc",
        "zone_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "zone_status": {
                "const": "assumed"
              }
            }
          },
          "then": {
            "required": [
              "assumption_id",
              "offset_minutes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "zone_status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "assumption_id"
                  ]
                },
                {
                  "required": [
                    "offset_minutes"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "event": {
      "type": "object"
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "ip": {
          "type": "string",
          "anyOf": [
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "properties": {
        "user_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
